#
# MSSQL connection - copy to .env and fill in values (never commit .env)
#
MSSQL_SERVER=your_server
MSSQL_PORT=1435
MSSQL_USER=sa
MSSQL_PASSWORD=your_password
MSSQL_DATABASE=fiesSaas1971

#
# Optional: separate auth DB (defaults to MSSQL_* if omitted)
#
# AUTH_MSSQL_SERVER=your_auth_server
# AUTH_MSSQL_PORT=1435
# AUTH_MSSQL_USER=sa
# AUTH_MSSQL_PASSWORD=your_auth_password
# AUTH_MSSQL_DATABASE=auth_database

#
# Optional: Gen-AI assistant (AI page)
# Set OPENAI_API_KEY only if you want to enable the AI Assistant.
#
# OPENAI_API_KEY=your_openai_or_compatible_api_key
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

#
# Optional: Auth token settings (for persistent login)
#
# AUTH_TOKEN_SECRET=change_this_to_a_long_random_string
# AUTH_TOKEN_TTL_MINUTES=480
